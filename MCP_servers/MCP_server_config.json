{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--browser=firefox"],
      "env": {
        "DISPLAY": ":1"
      }
    }, 

    "filesystem": {
      "command": "mcp-server-filesystem",
      "args": [
        "--project-dir",
        "../run",
        "--reference-project",
        "libs=../Human_code_library",
        "--log-level",
        "INFO"
      ]
    }
  }
}