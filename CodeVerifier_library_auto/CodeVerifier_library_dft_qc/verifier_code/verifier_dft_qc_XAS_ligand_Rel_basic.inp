# keywords ------------------------------------------------------------------------------------------
# a keywords input block for XAS_ligand_Rel system: DFT setup with ZORA and dense grid
! B3LYP ZORA TightSCF DefGrid2 SP
# scf ------------------------------------------------------------------------------------------
# a scf input block for XAS_ligand_Rel system: SCF convergence settings
%scf
  MaxIter 150
  DirectResetFreq 20
end

# rel ------------------------------------------------------------------------------------------
# a rel input block for XAS_ligand_Rel system: ZORA settings
%rel
end

# basis ------------------------------------------------------------------------------------------
# a basis input block for XAS_ligand_Rel system: relativistic per-element basis set assignment
%basis
  NewGTO Cu "ZORA-def2-TZVPP" end
  NewGTO C  "ZORA-def2-SVP" end
  NewGTO F  "ZORA-def2-SVP" end
end

# cosmo ------------------------------------------------------------------------------------------
# a cosmo input block for XAS_ligand_Rel system: implementing CPCM
%cpcm
  epsilon 80.4
  refrac 1.33
  rsolv 1.3
  fepstype cosmo
end

# output ------------------------------------------------------------------------------------------
# a output input block for XAS_ligand_Rel system: controls print level and selected output sections
%output
  PrintLevel Normal
  Print[ P_Cartesian ] 1
  Print[ P_SCFInfo ] 1
  Print[ P_OrbEn ] 1
  Print[ P_MOs ] 1
  Print[ P_Basis ] 1
  Print[ P_Density ] 1
  Print[ P_SpinDensity ] 1
end

# method ------------------------------------------------------------------------------------------
# a method input block for XAS_ligand_Rel system: ROCIS relativistic XAS method
%method
end

# geometry ------------------------------------------------------------------------------------------
# a geometry input block for XAS_ligand_Rel system: Cu-centered complex with C and F ligands
* xyz 2 1
Cu  0.000000  0.000000  0.000000
C   1.900000  0.000000  0.000000
F   2.400000  1.200000  0.000000
F   2.400000 -0.600000  1.039230
F   2.400000 -0.600000 -1.039230
*
