# output ------------------------------------------------------------------------------------------
# a output input block for XAS_ligand_Rel system: controls print level and selected output sections
%output
  PrintLevel Normal
  Print[ P_Cartesian ] 1
  Print[ P_SCFInfo ] 1
  Print[ P_OrbEn ] 1
  Print[ P_MOs ] 1
  Print[ P_Basis ] 1
  Print[ P_Density ] 1
  Print[ P_SpinDensity ] 1
end