# keywords ------------------------------------------------------------------------------------------
# a keywords input block for Ceramic_cluster_XAS_geo_opt system: PBE ZORA Opt with TightSCF and high-quality grids.
! PBE ZORA TightSCF Opt ZORA-def2-TZVP AutoAux RI
%basis
  Basis "ZORA-def2-TZVP"
end

# method ------------------------------------------------------------------------------------------
# a method input block for Ceramic_cluster_XAS_geo_opt system: FrozenCore for core excitations and RunTyp for optimization
%scf
  MaxIter 500
  MaxCore 4000
end

# cpcm ------------------------------------------------------------------------------------------
# a cpcm input block for Ceramic_cluster_XAS_geo_opt system: CPCM solvation for XAS geometry optimization
%cpcm
  epsilon 80.4
  refrac 1.33
  surfacetype vdw_gaussian
end

# method ------------------------------------------------------------------------------------------
# a method input block for Ceramic_cluster_XAS_geo_opt system: FrozenCore for core excitations and RunTyp for optimization
%method
  FrozenCore FC_NONE
  Grid 4
  FinalGrid 5
end

# rel ------------------------------------------------------------------------------------------
%rel
  Method ZORA
end

# output ------------------------------------------------------------------------------------------
%output
  Print[ P_Basis ] 1
end

# tddft ------------------------------------------------------------------------------------------
%tddft
  NRoots 5
end

# geometry ------------------------------------------------------------------------------------------
* xyz 0 1
Ti 0.0000 0.0000 0.0000
O  1.8500 0.0000 0.0000
*

