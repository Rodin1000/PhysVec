#Tags_keywords
#Main methods and options from plan: BP86 functional with ZORA relativistic correction
#Plan specifies BP86, ZORA, def2-TZVP, CP(PPP), Grid7, COSMO for single-point energy calculation
! BP86 def2-TZVP def2/J Grid7 TightSCF

#Memory allocation for better performance
%maxcore 2000

#Tags_inputblocks_general
#General ORCA input blocks for DFT calculations
#Based on ORCA manual examples and standard DFT parameters
%basis
  newgto C "def2-TZVP" end
  newaux C "def2/J" end
  newgto H "def2-TZVP" end
  newaux H "def2/J" end
end

%scf
  MaxIter 200
  SCFMode Auto
  Thresh 1e-6
  TCut 1e-10
  SOSCFStart 0.01
  KDIIS true
  AutoAux true
  CNVTol 1e-6
  CNVSOSCF true
  STABPerform true
end

%output
  PrintLevel Normal
  Print[P_InputFile] 1
  Print[P_Basis] 2
end

%method
  D3 true
  Grid7 true
end



#Tags_geometryblocks
#General geometry block for ORCA input file
#Based on ORCA manual examples for standard geometry format
*xyz 0 1
C      0.00000    0.00000    0.00000
H      1.08900    0.00000    0.00000
H     -0.36300    1.02470    0.00000
H     -0.36300   -0.51235    0.88741
*
